# Valores ficticios. Copiar a .env (ignorado por git) y completar.
NUBERA_ENV=development
POSTGRES_USER=nubera
POSTGRES_PASSWORD=changeme
POSTGRES_DB=nubera

# Streaming (Icecast). Contraseñas ficticias: definir valores reales en .env
ICECAST_SOURCE_PASSWORD=changeme-source
ICECAST_RELAY_PASSWORD=changeme-relay
ICECAST_ADMIN_PASSWORD=changeme-admin
NUBERA_ICECAST_PORT=58000

# Base de datos y API (ajustar usuario/contraseña a los de arriba)
DATABASE_URL=postgres://nubera:changeme@127.0.0.1:55432/nubera
MEDIA_DIR=./data/storage
MAX_UPLOAD_MB=200
