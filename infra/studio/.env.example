# Valores ficticios. El instalador (install.sh) genera el .env real; este archivo muestra qué se puede definir.

# Dirección de la API de Nubera, terminada en /api si se entra por el panel público.
NUBERA_API_URL=https://nubera.example.test/api

# Token del motor de audio de esta emisora (Ajustes → Motor de audio, en el panel).
NUBERA_AGENT_TOKEN=nbr_reemplazar

# Placa de sonido. "aplay -l" lista las disponibles; "default" usa la predeterminada del sistema.
NUBERA_ALSA_DEVICE=default
# Grupo "audio" de esta PC (getent group audio). Normalmente 29.
AUDIO_GID=29

# Programas en vivo: entrada de línea donde llega la salida de la consola ("arecord -l" las lista).
# Vacío = durante un programa en vivo el streaming queda en silencio.
NUBERA_LIVE_INPUT_DEVICE=

# Días que un audio descargado queda guardado sin usarse.
NUBERA_CACHE_DAYS=30

# Streaming a la nube (opcional; sin esto el motor emite solo por la placa de sonido).
# El instalador completa estos valores si respondés que sí al streaming.
COMPOSE_PROFILES=streaming
ICECAST_HOST=stream-link
ICECAST_PORT=8000
ICECAST_MOUNT=/live
ICECAST_SOURCE_PASSWORD=reemplazar
ICECAST_NAME=Nubera
# Enlace seguro (Cloudflare Access): nombre público y token de servicio.
STREAM_LINK_HOSTNAME=source.example.test
STREAM_LINK_TOKEN_ID=reemplazar.access
STREAM_LINK_TOKEN_SECRET=reemplazar
