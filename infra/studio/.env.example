# Valores ficticios. El instalador (install.sh) genera el .env real; este archivo muestra qué se puede definir.

# Dirección de la API de Nubera, terminada en /api si se entra por el panel público.
NUBERA_API_URL=https://nubera.example.test/api

# Token del motor de audio de esta emisora (Ajustes → Motor de audio, en el panel).
NUBERA_AGENT_TOKEN=nbr_reemplazar

# Placa de sonido. "aplay -l" lista las disponibles; "default" usa la predeterminada del sistema.
NUBERA_ALSA_DEVICE=default
# Grupo "audio" de esta PC (getent group audio). Normalmente 29.
AUDIO_GID=29

# Días que un audio descargado queda guardado sin usarse.
NUBERA_CACHE_DAYS=30

# Streaming a Icecast (opcional; vacío = solo la placa de sonido).
ICECAST_HOST=
ICECAST_PORT=8000
ICECAST_MOUNT=/live
ICECAST_SOURCE_PASSWORD=
ICECAST_NAME=Nubera
